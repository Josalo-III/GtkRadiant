#!/bin/bash

RADIANT_HOME=$(cd "$(dirname "$0")/../.." && pwd)

echo
echo "Starting GtkRadiant in ${RADIANT_HOME}"
echo

set -x

resources="${RADIANT_HOME}/Contents/Resources"

if [ -z "${DISPLAY:-}" ]; then
	if [ -x /Applications/Utilities/XQuartz.app/Contents/MacOS/X11.bin ]; then
		open -ga XQuartz
	fi
	export DISPLAY=:0
fi

export FONTCONFIG_PATH="${resources}/etc/fonts"
export FC_DEBUG=1024

# Match the verified development launcher: MacPorts Mesa through XQuartz.
export GDK_GL_LIBGL_PATH="/opt/local/lib/libGL.dylib"
export GDK_GL_LIBGLU_PATH="/opt/X11/lib/libGLU.dylib"
export GDK_BACKEND=x11
export GDK_GL=legacy

export GDK_PATH="${resources}"
export GDK_PIXBUF_MODULE_FILE="${resources}/etc/gtk-3.0/gdk-pixbuf.loaders"

export GOBJECT_PATH="${resources}"

export GTK_DATA_PREFIX="${resources}"
export GTK_EXE_PREFIX="${resources}"
export GTK_PATH="${resources}"

export PANGO_SYSCONFDIR="${resources}/etc"
export PANGO_LIBDIR="${resources}/lib"

cd "${resources}/install"
./radiant.bin &

set +x
