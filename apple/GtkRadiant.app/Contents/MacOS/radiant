#!/bin/bash

RADIANT_HOME=$(cd "$(dirname "$0")/../.." && pwd)

echo
echo "Starting GtkRadiant in ${RADIANT_HOME}"
echo

set -x

resources="${RADIANT_HOME}/Contents/Resources"

# Keep generated game descriptions and preferences outside the application
# bundle.  This is required when running from a read-only DMG and also keeps a
# packaged release separate from a source-tree development profile.
user_data_root="${HOME}/Library/Application Support/GtkRadiant"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${user_data_root}}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-${user_data_root}}"

# MacPorts' libepoxy records its GL loader as an absolute /opt/local path and
# opens it at runtime.  Prefer the relocated copy so epoxy and radiant.bin use
# one libGL/X11 graph; loading both copies makes GtkGLArea report no compatible
# pixel formats.
export DYLD_LIBRARY_PATH="${resources}/lib${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"

if [ -z "${DISPLAY:-}" ]; then
	if [ -x /Applications/Utilities/XQuartz.app/Contents/MacOS/X11.bin ]; then
		open -ga XQuartz
	fi
	export DISPLAY=:0
fi

export FONTCONFIG_PATH="${resources}/etc/fonts"
export FC_DEBUG=1024

# The executable has a bundled, internally consistent MacPorts GLX/X11
# dependency graph.  Do not override it with a separate GL loader here: the
# known-good development launch does not set either GDK_GL_LIBGL*_PATH.
export GDK_BACKEND=x11
export GDK_GL=legacy

export GDK_PATH="${resources}"
export GDK_PIXBUF_MODULE_FILE="${resources}/etc/gtk-3.0/gdk-pixbuf.loaders"

export GOBJECT_PATH="${resources}"

export GTK_DATA_PREFIX="${resources}"
export GTK_EXE_PREFIX="${resources}"
export GTK_PATH="${resources}"

export PANGO_SYSCONFDIR="${resources}/etc"
export PANGO_LIBDIR="${resources}/lib"

cd "${resources}/install"
./radiant.bin &

set +x
